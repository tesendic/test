<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="test.Application">
  <grid id="a1b2c" binding="mainPanel" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="450" height="300"/>
    </constraints>
    <properties/>
    <border type="etched" title="Login screen"/>
    <children>
      <component id="d3e4f" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="5" left="0" bottom="5" right="5" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Username"/>
        </properties>
      </component>
      <component id="g5h6i" class="javax.swing.JTextField" binding="textfieldUsername">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="5" left="0" bottom="5" right="0" weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties>
          <columns value="10"/>
        </properties>
      </component>
      <component id="j7k8l" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="0" left="0" bottom="5" right="5" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Password"/>
        </properties>
      </component>
      <component id="m9n0o" class="javax.swing.JPasswordField" binding="textFieldPassword">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="0" left="0" bottom="5" right="0" weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties>
          <columns value="10"/>
        </properties>
      </component>
      <component id="p1q2r" class="javax.swing.JButton" binding="btnLogin">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Login"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
